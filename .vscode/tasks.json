{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jekyll: Bundle Install",
      "type": "shell",
      "command": "bundle install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Jekyll: Install and Serve",
      "type": "shell",
      "command": "bundle exec jekyll serve --livereload --livereload-ignore \".omx/**,.omx/**/*\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Jekyll: Bundle Install",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
